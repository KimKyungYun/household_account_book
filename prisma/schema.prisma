// 부부 가계부 — 데이터 모델
//
// 원칙
//  - 금액은 Int(원 단위). KRW 는 소수 단위가 없고, Decimal 은 JSON 직렬화·zod·차트마다
//    변환이 붙는다. Int 상한 21.4억원 > 단일 거래이고 SUM 은 bigint 로 승격된다.
//  - 분담률은 basis point Int(0~10000). 실수 비율을 저장하지 않는다.
//  - 날짜는 @db.Date. timestamptz 로 두면 1일 거래가 전월로 새는 버그가 난다.
//  - 거래는 hard delete, 참조되는 마스터(Category/PaymentMethod/RecurringRule)만 isActive 아카이브.
//  - CHECK 제약과 부분 유니크 인덱스는 Prisma 로 표현할 수 없어 migration.sql 에서 보강한다.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // 관계(select 안의 member·category 등)를 관계마다 따로 묻지 않고 조인 한 번으로 가져온다.
  // DB 가 멀수록 왕복 횟수가 곧 응답 시간이라, 거래 목록 한 번에 왕복 3~4회가 1회로 준다.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────
// Auth.js
// ─────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  /// Credentials 로그인용 bcrypt 해시. 소셜 로그인만 쓰는 계정은 null.
  passwordHash  String?
  /// 숫자만('01012345678'). 선택 입력이고 문자 인증은 하지 않는다.
  phone           String?
  /// 개인정보 수집·이용에 동의한 시각. 가입할 때 필수로 받는다.
  privacyAgreedAt DateTime?

  accounts   Account[]
  sessions   Session[]
  membership HouseholdMember?
  createdTxs Transaction[]    @relation("TxCreatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────────
// 가구 / 구성원
// ─────────────────────────────────────────────────────────────────

/// 가구 유형. 정원과 고를 수 있는 관계가 이것으로 정해진다 (service/household/kind.ts).
enum HouseholdKind {
  COUPLE
  FAMILY
  SOLO
}

/// 가구 안에서의 관계. 유형마다 고를 수 있는 값이 다르다.
enum MemberRelation {
  HUSBAND
  WIFE
  FATHER
  MOTHER
  CHILD
  GRANDPARENT
  OTHER
  SELF
}

model Household {
  id       String @id @default(cuid())
  name     String
  kind     HouseholdKind @default(COUPLE)
  currency String @default("KRW")
  timezone String @default("Asia/Seoul")
  /// 함께 쓸 사람을 초대할 때 쓰는 코드. 재발급 가능.
  inviteCode String @unique @default(cuid())
  /// 급여일 기준 회계월. v1 은 1(달력월) 고정이고 필드만 예약한다.
  fiscalStartDay Int @default(1)
  /// 반복 거래 lazy 백필을 하루 1회로 스로틀하기 위한 표시.
  lastRecurringRunOn DateTime? @db.Date

  members        HouseholdMember[]
  categories     Category[]
  paymentMethods PaymentMethod[]
  transactions   Transaction[]
  budgets        Budget[]
  recurringRules RecurringRule[]
  assets         Asset[]
  loans          Loan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HouseholdMember {
  id          String @id @default(cuid())
  householdId String
  userId      String @unique
  /// 0 ~ 5 — 들어온 순서. 색과 목록 정렬이 흔들리지 않게 고정한다.
  slot        Int
  relation    MemberRelation @default(OTHER)
  displayName String
  colorHex    String @default("#1f6feb")
  isActive    Boolean @default(true)

  household      Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  paymentMethods PaymentMethod[]
  recurringRules RecurringRule[]
  assets         Asset[]
  loans          Loan[]

  joinedAt DateTime @default(now())

  @@unique([householdId, slot])
  @@index([householdId])
}

// ─────────────────────────────────────────────────────────────────
// 카테고리 (self-relation 2단)
// ─────────────────────────────────────────────────────────────────

enum CategoryKind {
  EXPENSE
  INCOME
  /// 계좌간 이동·카드대금 납부·저축. 수입도 지출도 아니라 모든 집계에서 제외한다.
  TRANSFER
}

/// 같이 쓴 돈인지 각자 쓴 돈인지. 분류로만 쓰고 정산 계산은 하지 않는다.
enum SplitMode {
  /// 같이 쓴 돈 — 장 보기, 월세처럼 둘의 살림에 들어간 지출.
  SHARED
  /// 각자 쓴 돈 — 용돈·미용처럼 한 사람에게만 속한 지출.
  PERSONAL
}

model Category {
  id          String  @id @default(cuid())
  householdId String
  parentId    String?
  /// 1 = 대분류, 2 = 소분류. parentId 와의 정합은 DB CHECK 로 고정한다.
  level       Int
  kind        CategoryKind
  name        String
  icon        String?
  colorHex    String?
  sortOrder   Int          @default(0)
  /// 비활성 = soft delete. 기존 거래는 그대로 남고 선택 목록에서만 빠진다.
  isActive    Boolean      @default(true)
  /// 시딩된 기본 카테고리. 개명은 되지만 삭제는 막는다.
  isSystem    Boolean      @default(false)
  /// 미지정이면 SHARED 로 본다. 용돈·미용은 PERSONAL 로 시딩한다.
  defaultSplitMode SplitMode?
  archivedAt       DateTime?

  household      Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  parent         Category?       @relation("CategoryTree", fields: [parentId], references: [id])
  children       Category[]      @relation("CategoryTree")
  transactions   Transaction[]
  budgets        Budget[]
  recurringRules RecurringRule[]
  loanInterests  Loan[]          @relation("LoanInterestCategory")
  loanPrincipals Loan[]          @relation("LoanPrincipalCategory")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId, kind, isActive])
  @@index([householdId, parentId, sortOrder])
}

// ─────────────────────────────────────────────────────────────────
// 결제수단
// ─────────────────────────────────────────────────────────────────

enum PaymentMethodKind {
  CASH
  DEBIT_CARD
  CREDIT_CARD
  BANK_TRANSFER
  EASY_PAY
  GIFT_CARD
  OTHER
}

model PaymentMethod {
  id            String            @id @default(cuid())
  householdId   String
  name          String
  kind          PaymentMethodKind
  /// 개인 카드면 소유자. 공동 수단은 null.
  ownerMemberId String?
  last4         String?
  sortOrder     Int               @default(0)
  isActive      Boolean           @default(true)

  household      Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  owner          HouseholdMember? @relation(fields: [ownerMemberId], references: [id])
  transactions   Transaction[]
  recurringRules RecurringRule[]
  loans          Loan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([householdId, name])
  @@index([householdId, isActive])
}

// ─────────────────────────────────────────────────────────────────
// 거래
// ─────────────────────────────────────────────────────────────────

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum TransactionSource {
  MANUAL
  RECURRING
  IMPORT
}


model Transaction {
  id          String @id @default(cuid())
  householdId String
  /// 실제로 결제·수령한 구성원. 정산의 'paid' 기준.
  memberId    String
  type        TransactionType
  date        DateTime @db.Date
  /// 원 단위. 음수는 환불/정정이며 SUM 이 자동 상계한다.
  amount      Int
  /// TRANSFER 만 null 을 허용한다 (DB CHECK).
  categoryId      String?
  paymentMethodId String?
  splitMode       SplitMode         @default(SHARED)
  merchant        String?
  memo            String?
  source          TransactionSource @default(MANUAL)
  recurringRuleId String?
  /// 이 돈이 쌓이는 자산. '옮긴 돈'에만 붙는다 (DB CHECK).
  /// 적금·투자처럼 나가서 모이는 돈을 자산 잔액으로 잇는 고리다.
  assetId         String?
  /// 이 거래를 만든 대출. 상환 회차에서 생성된 이자·원금 거래에 붙는다.
  loanId          String?
  /// 계좌간 이동의 짝 거래. 수정·삭제는 항상 쌍으로 처리한다.
  transferPeerId  String? @unique
  refundOfId      String?
  /// 할부 개월 — 표시용. v1 은 결제 시점 총액 1건으로 기록한다.
  installmentMonths Int?
  /// 더블 서브밋 멱등키. 모바일 네트워크 재시도에서 실제로 발생한다.
  clientRequestId String?
  createdById     String
  /// 낙관적 동시성 — 부부가 같은 거래를 동시에 고칠 때 409 로 막는다.
  version         Int @default(0)

  household     Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  member        HouseholdMember    @relation(fields: [memberId], references: [id])
  category      Category?          @relation(fields: [categoryId], references: [id])
  paymentMethod PaymentMethod?     @relation(fields: [paymentMethodId], references: [id])
  recurringRule RecurringRule?     @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)
  asset         Asset?             @relation(fields: [assetId], references: [id], onDelete: SetNull)
  createdBy     User               @relation("TxCreatedBy", fields: [createdById], references: [id])
  loan          Loan?              @relation(fields: [loanId], references: [id], onDelete: SetNull)
  refundOf      Transaction?       @relation("Refund", fields: [refundOfId], references: [id])
  refunds       Transaction[]      @relation("Refund")
  occurrence    RecurringOccurrence?
  loanInterestOf  LoanPayment?     @relation("LoanInterestTx")
  loanPrincipalOf LoanPayment?     @relation("LoanPrincipalTx")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([householdId, clientRequestId])
  @@index([householdId, date, id])
  @@index([householdId, type, date])
  @@index([householdId, categoryId, date])
  @@index([householdId, memberId, date])
  @@index([householdId, splitMode, date])
  @@index([recurringRuleId])
  @@index([createdById])
  @@index([paymentMethodId])
  @@index([refundOfId])
  @@index([householdId, assetId, date])
  @@index([loanId])
}


// ─────────────────────────────────────────────────────────────────
// 예산
// ─────────────────────────────────────────────────────────────────

model Budget {
  id          String @id @default(cuid())
  householdId String
  /// 대분류·소분류 모두 가능. 대분류 예산의 실적은 하위 합계 + 대분류 직접 지출.
  categoryId  String
  /// "2026-01"
  yearMonth   String @db.Char(7)
  /// 행이 없으면 '예산 미설정'(소진율 null), 0 이면 '의도적 0원 예산'이다. 이 둘을 구분한다.
  amount      Int
  memo        String?

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([householdId, categoryId, yearMonth])
  @@index([householdId, yearMonth])
  @@index([categoryId])
}

// ─────────────────────────────────────────────────────────────────
// 반복 거래
// ─────────────────────────────────────────────────────────────────

enum RecurrenceFreq {
  WEEKLY
  MONTHLY
  YEARLY
}

model RecurringRule {
  id          String  @id @default(cuid())
  householdId String
  name        String
  isActive    Boolean @default(true)

  // 거래 템플릿
  type            TransactionType
  memberId        String
  categoryId      String?
  paymentMethodId String?
  amount          Int
  splitMode       SplitMode @default(SHARED)
  /// 이 돈이 쌓이는 자산. '옮긴 돈' 규칙에만 붙는다.
  assetId         String?
  merchant        String?
  memo            String?

  // 반복 규칙 (구조화 필드 — cron 문자열로는 '말일'·'격월'·'종료일'을 표현할 수 없다)
  freq        RecurrenceFreq
  /// 1 = 매월, 2 = 격월. startDate 의 월을 기준점으로 삼아 드리프트를 막는다.
  interval    Int            @default(1)
  /// 1~31 (MONTHLY/YEARLY). 31 은 말일을 겸한다 — 그 달 일수로 클램프한다.
  dayOfMonth  Int?
  /// 0(일)~6 (WEEKLY)
  weekday     Int?
  /// 1~12 (YEARLY)
  monthOfYear Int?
  startDate   DateTime  @db.Date
  endDate     DateTime? @db.Date
  /// 백필 시작 힌트(성능용). 정합의 근거는 RecurringOccurrence 다.
  lastGeneratedOn DateTime? @db.Date

  household     Household             @relation(fields: [householdId], references: [id], onDelete: Cascade)
  member        HouseholdMember       @relation(fields: [memberId], references: [id])
  category      Category?             @relation(fields: [categoryId], references: [id])
  paymentMethod PaymentMethod?        @relation(fields: [paymentMethodId], references: [id])
  asset         Asset?                @relation(fields: [assetId], references: [id], onDelete: SetNull)
  occurrences   RecurringOccurrence[]
  transactions  Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId, isActive])
  @@index([memberId])
  @@index([categoryId])
  @@index([paymentMethodId])
}

/// "이 회차는 이미 처리했다" 는 멱등 원장.
/// 이 테이블이 없으면 사용자가 지운 반복 거래가 다음 백필에서 되살아난다.
model RecurringOccurrence {
  id             String   @id @default(cuid())
  ruleId         String
  occurrenceDate DateTime @db.Date
  transactionId  String?  @unique
  /// 사용자가 건너뛰거나 생성분을 지운 회차.
  skipped        Boolean  @default(false)

  rule        RecurringRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  transaction Transaction?  @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([ruleId, occurrenceDate])
}

// ─────────────────────────────────────────────────────────────────
// 월 정산 확정
// ─────────────────────────────────────────────────────────────────


// ─────────────────────────────────────────────────────────────────
// 자산
// ─────────────────────────────────────────────────────────────────

/// 모으는 돈의 종류. 빚은 아직 다루지 않는다 —
/// 대출 상환은 잔액이 줄어드는 방향이라 '옮긴 돈'(양수만 허용)으로는 표현할 수 없다.
enum AssetKind {
  /// 적금·예금
  SAVINGS
  /// 주식·펀드·ETF
  INVESTMENT
  /// 현금·수시입출금 통장
  CASH
  /// 연금·퇴직연금
  PENSION
  OTHER
}

/// 모으는 자산 한 건 — '청년미래적금', '주식' 처럼 사람이 이름 붙인 통.
///
/// **잔액을 저장하지 않는다.** `openingBalance` 에서 시작해 이 자산으로 들어간
/// 거래를 더해 계산한다. 저장해 두면 거래를 고칠 때마다 맞춰야 하고, 한 번
/// 어긋나면 어느 쪽이 맞는지 알 수 없다.
model Asset {
  id            String    @id @default(cuid())
  householdId   String
  name          String
  kind          AssetKind
  /// 개인 자산이면 소유자. 둘의 공동이면 null.
  ownerMemberId String?
  colorHex      String?
  /// 이 앱에 적기 전에 이미 모여 있던 금액. 여기서부터 거래를 더한다.
  openingBalance Int     @default(0)
  /// 모으려는 목표액. 정하지 않았으면 null.
  targetAmount   Int?
  sortOrder      Int     @default(0)
  isActive       Boolean @default(true)
  memo           String?

  household    Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  owner        HouseholdMember? @relation(fields: [ownerMemberId], references: [id])
  transactions Transaction[]
  recurringRules RecurringRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([householdId, name])
  @@index([householdId, isActive])
  @@index([ownerMemberId])
}

/// 갚고 있는 빚. 자산(Asset)과 부호가 반대이고 금리·만기·상환방식처럼 자산에 없는 필드가
/// 붙으므로 `AssetKind` 에 종류를 더하지 않고 따로 둔다.
model Loan {
  id          String   @id @default(cuid())
  householdId String
  name        String
  kind        LoanKind
  /// 최초 원금 (원).
  principal   Int
  /// 연 금리 basis point. 4.25% → 425. float 로 두면 360 회차를 누적하며 원 단위가 어긋난다.
  annualRateBp Int
  repaymentType RepaymentType
  /// 거치를 포함한 전체 상환 개월.
  termMonths        Int
  /// 이자만 내는 앞 구간. termMonths 에 포함된다.
  gracePeriodMonths Int @default(0)
  /// 첫 상환일. 이 날짜의 '일' 이 매달 되풀이된다(31 은 말일을 겸한다).
  firstPaymentDate  DateTime @db.Date

  /// 상환을 맡은 구성원. 생성되는 거래의 결제자가 된다.
  memberId            String
  paymentMethodId     String?
  /// 이자가 기록될 지출 카테고리 (EXPENSE).
  interestCategoryId  String
  /// 원금이 기록될 이체 카테고리 (TRANSFER). 원금 상환은 비용이 아니라 부채 감소다.
  principalCategoryId String

  colorHex  String?
  memo      String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
  /// 순자산(모은 돈 − 갚을 돈)에 이 대출을 셀지.
  /// 전세대출처럼 짝이 되는 자산을 앱에 넣지 않았다면 빼야 순자산이 실제보다 낮게 보이지 않는다.
  includeInNetWorth Boolean @default(true)

  household         Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  member            HouseholdMember @relation(fields: [memberId], references: [id])
  paymentMethod     PaymentMethod?  @relation(fields: [paymentMethodId], references: [id])
  interestCategory  Category        @relation("LoanInterestCategory", fields: [interestCategoryId], references: [id])
  principalCategory Category        @relation("LoanPrincipalCategory", fields: [principalCategoryId], references: [id])
  payments          LoanPayment[]
  transactions      Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([householdId, name])
  @@index([householdId, isActive])
  @@index([memberId])
  @@index([interestCategoryId])
  @@index([principalCategoryId])
  @@index([paymentMethodId])
}

/// 상환 스케줄 한 회차. `RecurringOccurrence` 와 같은 역할을 한다 —
/// 회차를 먼저 잡고 성공했을 때만 거래를 만들어 중복 생성을 DB 가 막는다.
model LoanPayment {
  id            String   @id @default(cuid())
  loanId        String
  installmentNo Int
  dueDate       DateTime @db.Date
  /// 이 회차에 갚는 원금. 거치 구간에서는 0 이다.
  principalAmount Int
  interestAmount  Int
  /// 이 회차를 갚고 난 뒤 남는 원금. 마지막 회차에서 0 이다.
  balanceAfter    Int
  /// 만들어진 거래 두 건. 이자는 지출, 원금은 이체로 따로 기록된다.
  interestTxId    String? @unique
  principalTxId   String? @unique
  /// 사용자가 건너뛰거나 생성분을 지운 회차.
  skipped         Boolean @default(false)

  loan        Loan         @relation(fields: [loanId], references: [id], onDelete: Cascade)
  interestTx  Transaction? @relation("LoanInterestTx", fields: [interestTxId], references: [id], onDelete: SetNull)
  principalTx Transaction? @relation("LoanPrincipalTx", fields: [principalTxId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([loanId, installmentNo])
  @@index([loanId, dueDate])
}

enum LoanKind {
  /// 주택담보대출
  MORTGAGE
  /// 전세자금대출
  JEONSE
  /// 신용대출
  CREDIT
  /// 자동차 할부·오토론
  CAR
  /// 학자금
  STUDENT
  OTHER
}

enum RepaymentType {
  /// 원리금균등 — 매달 내는 총액이 같다.
  EQUAL_PAYMENT
  /// 원금균등 — 매달 갚는 원금이 같고 총액은 줄어든다.
  EQUAL_PRINCIPAL
  /// 만기일시 — 매달 이자만 내고 만기에 원금을 한 번에 갚는다.
  INTEREST_ONLY
}
