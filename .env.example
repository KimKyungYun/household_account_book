# ── DB ───────────────────────────────────────────────────────────
# 로컬: docker compose up -d 로 띄운 Postgres
DATABASE_URL="postgresql://hab:hab@localhost:5432/household_account_book?schema=public"
# 배포(Neon): 앱은 pooled, 마이그레이션은 direct 를 쓴다
DIRECT_DATABASE_URL="postgresql://hab:hab@localhost:5432/household_account_book?schema=public"

# ── Auth.js ──────────────────────────────────────────────────────
# openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:4000"
AUTH_TRUST_HOST="true"

# ── 로컬 시드 (개발용) ────────────────────────────────────────────
SEED_HOUSEHOLD_NAME="우리집"
SEED_MEMBER_A_EMAIL="husband@example.com"
SEED_MEMBER_B_EMAIL="wife@example.com"
SEED_MEMBER_PASSWORD="password1234"

# ── 개발 서버를 다른 기기에서 열 때 ─────────────────────────────
# 이 머신의 LAN IP 는 next.config.ts 가 자동으로 허용한다.
# 그 밖의 호스트(도메인·터널 주소 등)를 열어야 할 때만 콤마로 적는다.
DEV_ALLOWED_ORIGINS=""
